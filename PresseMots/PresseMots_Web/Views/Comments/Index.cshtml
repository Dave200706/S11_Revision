@model PresseMots.ViewModel.CommentVM

@{
    ViewData["Title"] = "Liste des commentaires";
}

<h1>Commentaire(s) de :  </h1>

<div class="card">
    <div class="card-body">
        <div class="card-title"><h2>@ViewBag.StoryTitle</h2></div>
        <div class="card-text">
            @ViewBag.ShortStory (@ViewBag.WordCount mots)
            <a asp-action="Index" asp-controller="Stories" asp-route-id="@ViewBag.StoryId"> Consulter l'article</a>
        </div>
    </div>
</div>

<hr />

@foreach (var item in Model.Comments)
{
    <table class="table table-bordered">

        <tbody>
            <tr>
                <th style="width:30px;">
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().Email)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td style="width:150px;" rowspan="3">
                    <div>
                        <a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>

                    </div>
                    <div> <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a> </div>
                </td>
            </tr>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().DisplayName)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.DisplayName)
                </td>
            </tr>
            <tr>
                <th style="white-space:pre-wrap">
                    @Html.DisplayNameFor(model => model.Comments.FirstOrDefault().Content)
                </th>
                <td>
                    @Html.DisplayFor(modelItem => item.Content)
                </td>
            </tr>
        </tbody>
    </table>
}

<a asp-action="Create" asp-route-storyId="@ViewBag.StoryId">Nouveau commentaire</a>

